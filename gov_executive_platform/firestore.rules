rules_version = '2';

// قواعد أمان قاعدة البيانات للمنصة التنفيذية الحكومية.
// المصدر الوحيد للحقيقة بخصوص الصلاحيات هو Custom Claims على حساب Firebase Auth
// (role, departmentId, approved) والتي لا تُضبط إلا عبر Cloud Functions بصلاحيات المسؤول،
// بحيث لا يستطيع أي مستخدم من جهة العميل ترقية صلاحياته بنفسه.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isApproved() { return isSignedIn() && request.auth.token.approved == true; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return isApproved() && role() == 'systemAdmin'; }
    function isExecutive() { return isApproved() && role() == 'executiveViewer'; }
    // صلاحيات الأدوار: مجموعة أعلام مضغوطة مضمّنة داخل Custom Claims وقت تعيين
    // الدور أو تحديث صلاحياته (راجع setUserRole و refreshRolePermissions في
    // Cloud Functions)، وليست بالإمكان منحها ذاتياً من جهة العميل بأي حال.
    //
    // تسري على كل الأدوار (الأساسية والمخصصة) لا على "custom" وحده، لأن مسؤول
    // النظام صار يضبط صلاحيات الأدوار الأساسية من شاشة "صلاحيات الأدوار".
    // مسؤول النظام لا يمر من هنا إطلاقاً — يملك كل شيء عبر isAdmin().
    //
    // لا تشمل هذه الأعلام أبداً بوابات الموافقة الثلاث (تسجيل عضو / إضافة
    // مشروع / تعديل موعد نهائي)؛ تلك تبقى محصورة بـ isAdmin() وحده.
    function perm(key) {
      return isApproved()
             && request.auth.token.perms != null
             && request.auth.token.perms[key] == true;
    }
    function canViewAll() { return isAdmin() || isExecutive() || perm('vad'); }

    // ــــ الصلاحيات المقيَّدة بنطاق ــــ
    //
    // `mpr` (إنشاء المشاريع والأعمال وإسناد المستخدمين) و`apr` (اعتماد طلبات
    // إضافة المشاريع) لا تُمنحان لدور ولا يرثهما أحد: تُختمان على بطاقة فرد
    // بعينه ومعهما نطاق الإدارات التي تسريان فيه.
    //
    // و`apr` تفتح بوابةً كانت محصورة بمسؤول النظام (اعتماد إضافة المشاريع)
    // بقرار صريح منه. أما **تسجيل الأعضاء** و**تعديل المواعيد النهائية**
    // فتبقيان محصورتين به وحده ولا مفتاح لهما هنا.
    //
    // ونطاق غائب ليس «الكل»: علَمٌ بلا نطاق لا يمنح شيئاً — وهذا هو الفرق
    // الذي لو انعكس لصار كل منحٍ منقوصٍ منحاً شاملاً.
    // `get` بقيمة افتراضية لا الوصول المباشر: البطاقة قد لا تحمل `scopes`
    // إطلاقاً (كل البطاقات المختومة قبل هذه الميزة كذلك)، والوصول المباشر
    // إلى مفتاح غائب **يُخطئ** فيُرفض الطلب. والرفض هنا صحيح بالمصادفة لا
    // بالقصد: حراسةٌ قائمة على خطأٍ ضمني لا يمكن اختبارها ولا الوثوق ببقائها.
    function scopeOf(key) {
      return request.auth.token.get('scopes', {}).get(key, null);
    }
    function inScope(key, deptId) {
      return perm(key)
             && deptId != null
             && scopeOf(key) != null
             && (scopeOf(key) == '*' || deptId in scopeOf(key));
    }
    function myDept() { return request.auth.token.departmentId; }
    function isMyDept(deptId) { return isApproved() && deptId != null && myDept() == deptId; }
    function isDeptManager() { return isApproved() && role() == 'departmentManager'; }
    // مدير الإدارة قد يدير أكثر من إدارة واحدة (departmentIds بالـ Custom Claims).
    function myDepts() { return request.auth.token.departmentIds; }
    function isMyDeptOfManager(deptId) {
      return isApproved() && deptId != null && myDepts() != null && deptId in myDepts();
    }
    function isMyDeptAny(deptId) { return isMyDept(deptId) || isMyDeptOfManager(deptId); }
    // "مدير مشروع" (projectOfficer) مقيَّد بمشروعه المُسنَد إليه فقط عبر
    // managerUid المخزَّن على المشروع (ومنسوخ إلى المستندات التابعة له)، وليس
    // بإدارته كاملة كما هو الحال لمدير الإدارة.
    function isOfficer() { return isApproved() && role() == 'projectOfficer'; }
    function isMyProject(managerUid) { return isOfficer() && managerUid != null && managerUid == request.auth.uid; }
    // عضوية المشروع صارت قائمتين (تعدّد المديرين بقرار من مسؤول النظام).
    // الحقل المفرد managerUid يبقى مكتوباً للتوافق، لكن الفحص يعتمد القائمة.
    function managersOf(data) { return data.get('managerUids', []); }
    function executorsOf(data) { return data.get('executorUids', []); }
    function isProjectMember(data) {
      return isApproved() &&
             (request.auth.uid in managersOf(data) || request.auth.uid in executorsOf(data));
    }
    // صلاحية القراءة/الكتابة على مستند مرتبط بمشروع (تقدّم عبر departmentId و managerUid المنسوخين عليه).
    function canEditDept(deptId) { return isAdmin() || (isDeptManager() && isMyDeptOfManager(deptId)); }
    function canAccessProjectDoc(deptId, managerUid) { return canEditDept(deptId) || isMyProject(managerUid); }
    // صلاحية «الانضمام لمشاريع الإدارة» صارت تحكم **التسجيل** وحده — راجع
    // isSelfMembershipChange. أما الاطّلاع على مشاريع الإدارة فحقٌّ أساسي لكل
    // موظف فيها عبر isMyDeptAny في شرط القراءة أدناه، لا صلاحية تُمنح.
    //
    // وسبب ذلك عطلٌ وقع فعلاً: الاطّلاع كان معلَّقاً على بصمة في بطاقة الدخول،
    // وبطاقةُ من مُنح الصلاحية قد لا تُختم فوراً، فيرى الموظف منصة خالية بلا
    // سبب مفهوم. والقراءة داخل الإدارة لا تحتاج هذا التعليق أصلاً.
    function canBrowseDeptProjects(deptId) { return perm('sap') && isMyDeptAny(deptId); }

    // ــــ تسجيل الموظف نفسه على مشروع ــــ
    //
    // الفرق بين القائمة قبل التحديث وبعده يجب ألا يحوي إلا **معرّف المتصل**،
    // في الاتجاهين معاً: فلا يضيف أحدٌ غيره، ولا يُزيح زميله عن مشروعه. وهذا
    // مفروض على الخادم لا في الواجهة، لأن الواجهة يمكن تجاوزها.
    function selfOnlyDelta(before, after) {
      return after.toSet().difference(before.toSet()).hasOnly([request.auth.uid])
          && before.toSet().difference(after.toSet()).hasOnly([request.auth.uid]);
    }
    function onlyMembershipKeys() {
      return request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['managerUids', 'executorUids', 'managerUid']);
    }
    // الحقل المفرد الموروث ضمن المفاتيح المسموح تعديلها لأن العميل يكتبه مع
    // القائمة. وتركه بلا قيد ثغرة: يستطيع الموظف عندها ضبطه على **أي أحد**
    // فيُسنِد المشروع لمن ليس عضواً فيه. فيُشترط أن يكون null أو عضواً.
    function legacyManagerConsistent() {
      return request.resource.data.get('managerUid', null) == null
          || request.resource.data.get('managerUid', null) in managersOf(request.resource.data);
    }
    function isSelfMembershipChange() {
      return isApproved()
          && perm('sap')
          && isMyDeptAny(deptOf(resource.data))
          && onlyMembershipKeys()
          && legacyManagerConsistent()
          && selfOnlyDelta(managersOf(resource.data), managersOf(request.resource.data))
          && selfOnlyDelta(executorsOf(resource.data), executorsOf(request.resource.data));
    }
    // عند إنشاء مستند تابع لمشروع (مهمة/تحديث يومي/خطر/عائق)، نتحقق أن الحقول
    // المنسوخة (departmentId، managerUid) تطابق فعلاً مستند المشروع الحقيقي،
    // حتى لا يستطيع عميل خبيث انتحال managerUid لا يملكه للوصول لمشروع غيره.
    function realProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    // عضوية المشروع **الحقيقي** لا الحقل المنسوخ على المستند الجديد.
    //
    // كتابة التحديثات والمهام والمخاطر والعوائق كانت تُفحص بـ managerUid
    // المنسوخ، وهو أوّل اسم في قائمة المديرين وحده. فمنذ تعدّد المديرين صار
    // المدير الثاني — والمنفّذ المُسنَد — ممنوعَين من كتابة تحديث يومي على
    // مشروعهم. والقراءة كانت تعرف العضوية أصلاً؛ الكتابة وحدها تخلّفت.
    function isMemberOfRealProject(projectId) {
      return isApproved() && isProjectMember(realProject(projectId));
    }
    function matchesRealProject(projectId, deptId, managerUid) {
      let p = realProject(projectId);
      return deptOf(p) == deptId && managerOf(p) == managerUid;
    }
    // وصول آمن للحقلين على مستندات قد تكون قديمة (سابقة لإضافة managerUid)
    // وتفتقد الحقل أصلاً؛ الوصول المباشر بالنقطة يفشل في هذه الحالة.
    function deptOf(data) { return data.get('departmentId', null); }
    function managerOf(data) { return data.get('managerUid', null); }

    // ------------------------- المستخدمون -------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isApproved());
      allow list: if isApproved();
      // التسجيل الذاتي: يُنشئ المستخدم سجله الخاص فقط بحالة "بانتظار الموافقة" ودور أساسي،
      // لا يمكنه منح نفسه دوراً أعلى أو حالة معتمدة مباشرة.
      //
      // والحقلان الأخيران لا يقلّان خطراً عن الدور، وكلاهما يُقرأ على الخادم:
      // `emailVerificationExempt` يتخطّى شرط البريد الوزاري عند الاعتماد،
      // و`permissionOverrides` تُدمج في بطاقة الدخول عند ختمها. فمن كتبهما
      // على سجله لحظة التسجيل منح نفسه ما لم يمنحه أحد. يبقيان لمسؤول
      // النظام وحده عبر `allow update` أدناه.
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'projectOfficer'
                    && request.resource.data.get('emailVerificationExempt', false) == false
                    && request.resource.data.get('permissionOverrides', {}).keys().size() == 0;
      // أي تغيير على الدور/الحالة/الإدارة لا يتم إلا عبر مسؤول النظام (عادة عبر Cloud Function).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------- الإدارات -------------------------
    // قراءة عامة (حتى قبل تسجيل الدخول) لأن أسماء الإدارات تُعرض في نموذج إنشاء الحساب
    // لاختيار الإدارة المطلوبة؛ لا تحتوي على أي بيانات حساسة.
    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------- أقسام الإدارات وأقسامها الفرعية -------------------
    // تنظيم داخلي للإدارة (إدارة ← قسم ← قسم فرعي) يُسنَد إليه المشروع عبر
    // sectionId. أسماء أقسام مجرّدة لا تحمل بيانات مشاريع، فتُقرأ كما تُقرأ
    // الإدارات نفسها. الكتابة لمسؤول النظام أو مدير الإدارة صاحبة القسم —
    // ولا علاقة لهذا ببوابات الاعتماد الثلاث.
    match /sections/{id} {
      allow read: if true;
      allow create: if isAdmin() || isMyDeptAny(deptOf(request.resource.data));
      // نقل قسم بين الإدارات لمسؤول النظام وحده: هو قرار هيكلي يغيّر من يرى
      // مشاريع القسم ومن يعدّلها. مدير الإدارة يعدّل أقسامه داخل إدارته فقط،
      // ولا يستطيع تمرير قسم إلى إدارة لا يملكها.
      allow update: if isAdmin()
                    || (isMyDeptAny(deptOf(resource.data))
                        && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['departmentId']));
      allow delete: if isAdmin() || isMyDeptAny(deptOf(resource.data));
    }

    // ------------------------- المشاريع -------------------------
    match /projects/{id} {
      // القراءة: من يرى كل الإدارات، أو من يملك المشروع إدارةً أو مديراً، أو
      // عضو فيه، أو **أي موظف معتمد في إدارة المشروع**. والأخير هو ما يجعل
      // الموظف يرى مشاريع إدارته فور اعتماده بلا صلاحية إضافية.
      allow read: if isApproved() && (canViewAll()
                                      || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                                      || isProjectMember(resource.data)
                                      || isMyDeptAny(deptOf(resource.data)));
      // مسؤول النظام يُنشئ مباشرةً، ومعه من مُنِح `mpr` **داخل نطاقه**.
      // ومن لا يملكها يمرّ بطلب اعتماد كما كان — وهذا هو الوضع الافتراضي
      // لكل المستخدمين، فالمنحة لا يرثها دور ولا تُفتح إلا بقرار فردي.
      allow create: if isAdmin() || inScope('mpr', deptOf(request.resource.data));
      // يمكن لمدير الإدارة أو مدير المشروع المُسنَد إليه تحديث حقول التقدم والحالة
      // فقط، دون المساس بالموعد النهائي أو نقل المشروع لإدارة أخرى أو تغيير
      // مديره - أي تغيير في الموعد النهائي يمر عبر طلب موافقة منفصل، وتغيير
      // مدير المشروع لا يقوم به إلا مسؤول النظام.
      allow update: if isAdmin()
                    || (canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['dueDate', 'departmentId', 'createdByUid',
                                       'managerUid', 'managerUids', 'executorUids']))
                    // مدير الإدارة يعدّل فريق مشاريع إدارته كاملاً، ومعه
                    // صاحب `mpr` داخل نطاقه — وهو شقّ «إسناد المستخدمين».
                    || ((canEditDept(deptOf(resource.data)) || inScope('mpr', deptOf(resource.data)))
                        && onlyMembershipKeys()
                        && legacyManagerConsistent())
                    // والموظف يسجّل **نفسه فقط** — راجع selfOnlyDelta.
                    || isSelfMembershipChange();
      allow delete: if isAdmin();
    }

    // ------------------------- مهام المشاريع -------------------------
    match /tasks/{id} {
      allow read: if isApproved() && (canViewAll()
                                      || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                                      || isProjectMember(resource.data)
                                      || isMyDeptAny(deptOf(resource.data)));
      allow create: if (canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                        || isMemberOfRealProject(request.resource.data.projectId))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      allow update: if canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['projectId', 'departmentId', 'managerUid']);
      allow delete: if isAdmin();
    }

    // ------------------------- التحديثات اليومية (سجل غير قابل للتعديل) -------------------------
    match /dailyUpdates/{id} {
      allow read: if isApproved() && (canViewAll()
                                      || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                                      || isProjectMember(resource.data)
                                      || isMyDeptAny(deptOf(resource.data)));
      allow create: if (canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                        || isMemberOfRealProject(request.resource.data.projectId))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      // السجل غير قابل للتعديل إطلاقاً. الحذف مسموح لمسؤول النظام فقط، وهو
      // لازم لحذف مشروع أو إدارة حذفاً متسلسلاً دون ترك تحديثات يتيمة.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ------------------------- المخاطر والعوائق -------------------------
    match /risks/{id} {
      allow read: if isApproved() && (canViewAll()
                                      || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                                      || isProjectMember(resource.data)
                                      || isMyDeptAny(deptOf(resource.data)));
      allow create: if (canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                        || isMemberOfRealProject(request.resource.data.projectId))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      allow update: if canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['projectId', 'departmentId', 'managerUid']);
      allow delete: if isAdmin();
    }

    match /blockers/{id} {
      allow read: if isApproved() && (canViewAll()
                                      || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                                      || isProjectMember(resource.data)
                                      || isMyDeptAny(deptOf(resource.data)));
      allow create: if (canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                        || isMemberOfRealProject(request.resource.data.projectId))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      allow update: if canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['projectId', 'departmentId', 'managerUid']);
      allow delete: if isAdmin();
    }

    // ------------------- تثبيتات لوحة كل مستخدم -------------------
    // ما يختار مسؤول النظام إظهاره في لوحة قيادة مستخدم بعينه. المستخدم يقرأ
    // مستنده فقط ولا يكتبه — فلا يثبّت أحد لنفسه شيئاً.
    match /userFocus/{uid} {
      allow read: if isAdmin() || (isApproved() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ------------------- تخطيط لوحة كل مستخدم -------------------
    // تخصيص المستخدم لترتيب ودجات لوحته. بخلاف userFocus أعلاه، هذا المستند
    // يكتبه صاحبه بنفسه — فهو تفضيل عرض شخصي لا يرى أحد غيره، ولا يمنح أي
    // بيانات إضافية: كل ودجت يظل محكوماً بصلاحيات قراءة مصدره.
    match /userDashboards/{uid} {
      allow read, write: if isApproved() && request.auth.uid == uid;
    }

    // ------------------------- الأعمال التشغيلية -------------------------
    // بنود عمل مستقلة عن المشاريع، مُسنَدة لموظف داخل إدارة.
    match /works/{id} {
      // يقرأها من يرى كل الإدارات، أو مدير الإدارة صاحبة العمل، أو الموظف
      // المُسنَد إليه العمل نفسه.
      allow read: if isApproved()
                  && (canViewAll()
                      || isMyDeptAny(deptOf(resource.data))
                      || resource.data.get('assigneeUid', '') == request.auth.uid);
      // الإنشاء والإسناد لمن يملك صلاحية "إدارة الأعمال" ضمن نطاقه.
      allow create: if isAdmin()
                    || (perm('mw')
                        && (canViewAll() || isMyDeptAny(deptOf(request.resource.data))))
                    || inScope('mpr', deptOf(request.resource.data));
      // الموظف المُسنَد إليه يحدّث تقدّم عمله وحالته فقط، دون إعادة إسناده
      // لنفسه أو نقله لإدارة أخرى.
      allow update: if isAdmin()
                    || (perm('mw') && (canViewAll() || isMyDeptAny(deptOf(resource.data))))
                    || (resource.data.get('assigneeUid', '') == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['departmentId', 'assigneeUid', 'createdByUid']));
      allow delete: if isAdmin() || perm('del');
    }

    // ------------------------- الشكاوى والاقتراحات -------------------------
    // ما يرفعه الموظف إلى مسؤول النظام. صلاحيتان منفصلتان:
    //   sfb — الرفع، ومتابعة ما رفعه هو.
    //   mfb — الاطّلاع على كل الوارد والبتّ فيه.
    // ويُمنحان لدور كامل أو لشخص بعينه (راجع permissionOverrides على المستخدم).
    match /feedback/{id} {
      // صاحبها يراها دائماً ولو سُحبت منه صلاحية الرفع لاحقاً — وإلا اختفى
      // عنه ما رفعه هو وردُّ مسؤول النظام عليه.
      allow read: if isApproved()
                  && (isAdmin() || perm('mfb') || resource.data.submittedByUid == request.auth.uid);
      // لا يرفع أحدٌ باسم غيره، ولا يرفع شكوى مبتوتاً فيها سلفاً.
      allow create: if isApproved()
                    && perm('sfb')
                    && request.resource.data.submittedByUid == request.auth.uid
                    && request.resource.data.status == 'submitted'
                    && request.resource.data.get('responseNote', null) == null;
      // البتّ لمن يتابعها. ونصُّ الشكوى نفسه لا يُعدَّل بعد رفعها — لا من
      // صاحبها ولا ممن يبتّ فيها — فهي سجلٌّ لا مسوَّدة.
      allow update: if (isAdmin() || perm('mfb'))
                    && request.resource.data.diff(resource.data).affectedKeys()
                         .hasOnly(['status', 'responseNote', 'handledByName', 'handledAt']);
      allow delete: if isAdmin();
    }

    // ------------------------- طلبات الموافقة (مركز القرارات التنفيذية) -------------------------
    // تسجيل عضو / إضافة مشروع / تعديل موعد نهائي / قرار تنفيذي عام.
    match /approvalRequests/{id} {
      allow read: if isApproved()
                  && (isAdmin() || isExecutive()
                      || resource.data.requestedByUid == request.auth.uid
                      || isMyDeptAny(resource.data.departmentId));
      // يُسمح بالإنشاء حتى لمستخدم غير معتمد بعد (حالة التسجيل الذاتي).
      allow create: if isSignedIn();
      // لا يُعدَّل حقل الحالة (اعتماد/رفض) مباشرة من العميل بأي حال؛
      // الاعتماد الفعلي يتم حصرياً عبر Cloud Functions (approveRequest / rejectRequest)
      // التي تستخدم صلاحيات المسؤول الخلفية وتتحقق من الدور فعلياً على الخادم.
      allow update, delete: if false;
    }

    // ------------------------- سجل التدقيق -------------------------
    // القراءة حصراً لمسؤول النظام؛ لا يملك أي دور مخصص أو دور آخر الاطلاع عليه.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isApproved();
      allow update, delete: if false;
    }

    // ------------------------- التقارير -------------------------
    match /reports/{id} {
      allow read: if isApproved();
      allow create, update: if isAdmin() || isExecutive() || perm('mr');
      allow delete: if isAdmin();
    }

    // ------------------------- تخصيص لوحة القيادة -------------------------
    match /dashboardConfig/{id} {
      allow read: if isApproved();
      allow write: if isAdmin() || perm('md');
    }

    // ودجات مخصصة لكل مشروع على حدة (صفحة المشروع) — نفس صلاحية تخصيص
    // لوحة القيادة، بمعرّف المستند هو معرّف المشروع نفسه.
    match /projectWidgets/{id} {
      allow read: if isApproved();
      allow write: if isAdmin() || perm('md');
    }

    // إشعارات عامة تظهر لكل المستخدمين أعلى كل الصفحات — إنشاء وحذف حصراً
    // من مسؤول النظام.
    match /announcements/{id} {
      allow read: if isApproved();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // ------------------------- الأدوار المخصصة -------------------------
    // تعريف الأدوار (الاسم ومجموعة الصلاحيات) يديره مسؤول النظام فقط؛ أما
    // تعيين دور لمستخدم معيّن فيتم حصراً عبر Cloud Function (setUserRole)
    // التي تضبط Custom Claims الفعلية.
    match /roles/{id} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ------------------------- إعدادات المظهر (ألوان الهوية) -------------------------
    // قراءة عامة (حتى قبل تسجيل الدخول) لأن الألوان تُطبَّق على شاشتي الدخول
    // والتسجيل أيضاً؛ لا تحتوي على أي بيانات حساسة. التعديل حصراً لمسؤول النظام.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
