rules_version = '2';

// قواعد أمان قاعدة البيانات للمنصة التنفيذية الحكومية.
// المصدر الوحيد للحقيقة بخصوص الصلاحيات هو Custom Claims على حساب Firebase Auth
// (role, departmentId, approved) والتي لا تُضبط إلا عبر Cloud Functions بصلاحيات المسؤول،
// بحيث لا يستطيع أي مستخدم من جهة العميل ترقية صلاحياته بنفسه.
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() { return request.auth != null; }
    function isApproved() { return isSignedIn() && request.auth.token.approved == true; }
    function role() { return request.auth.token.role; }
    function isAdmin() { return isApproved() && role() == 'systemAdmin'; }
    function isExecutive() { return isApproved() && role() == 'executiveViewer'; }
    // صلاحيات الأدوار: مجموعة أعلام مضغوطة مضمّنة داخل Custom Claims وقت تعيين
    // الدور أو تحديث صلاحياته (راجع setUserRole و refreshRolePermissions في
    // Cloud Functions)، وليست بالإمكان منحها ذاتياً من جهة العميل بأي حال.
    //
    // تسري على كل الأدوار (الأساسية والمخصصة) لا على "custom" وحده، لأن مسؤول
    // النظام صار يضبط صلاحيات الأدوار الأساسية من شاشة "صلاحيات الأدوار".
    // مسؤول النظام لا يمر من هنا إطلاقاً — يملك كل شيء عبر isAdmin().
    //
    // لا تشمل هذه الأعلام أبداً بوابات الموافقة الثلاث (تسجيل عضو / إضافة
    // مشروع / تعديل موعد نهائي)؛ تلك تبقى محصورة بـ isAdmin() وحده.
    function perm(key) {
      return isApproved()
             && request.auth.token.perms != null
             && request.auth.token.perms[key] == true;
    }
    function canViewAll() { return isAdmin() || isExecutive() || perm('vad'); }
    function myDept() { return request.auth.token.departmentId; }
    function isMyDept(deptId) { return isApproved() && deptId != null && myDept() == deptId; }
    function isDeptManager() { return isApproved() && role() == 'departmentManager'; }
    // مدير الإدارة قد يدير أكثر من إدارة واحدة (departmentIds بالـ Custom Claims).
    function myDepts() { return request.auth.token.departmentIds; }
    function isMyDeptOfManager(deptId) {
      return isApproved() && deptId != null && myDepts() != null && deptId in myDepts();
    }
    function isMyDeptAny(deptId) { return isMyDept(deptId) || isMyDeptOfManager(deptId); }
    // "مدير مشروع" (projectOfficer) مقيَّد بمشروعه المُسنَد إليه فقط عبر
    // managerUid المخزَّن على المشروع (ومنسوخ إلى المستندات التابعة له)، وليس
    // بإدارته كاملة كما هو الحال لمدير الإدارة.
    function isOfficer() { return isApproved() && role() == 'projectOfficer'; }
    function isMyProject(managerUid) { return isOfficer() && managerUid != null && managerUid == request.auth.uid; }
    // صلاحية القراءة/الكتابة على مستند مرتبط بمشروع (تقدّم عبر departmentId و managerUid المنسوخين عليه).
    function canEditDept(deptId) { return isAdmin() || (isDeptManager() && isMyDeptOfManager(deptId)); }
    function canAccessProjectDoc(deptId, managerUid) { return canEditDept(deptId) || isMyProject(managerUid); }
    // عند إنشاء مستند تابع لمشروع (مهمة/تحديث يومي/خطر/عائق)، نتحقق أن الحقول
    // المنسوخة (departmentId، managerUid) تطابق فعلاً مستند المشروع الحقيقي،
    // حتى لا يستطيع عميل خبيث انتحال managerUid لا يملكه للوصول لمشروع غيره.
    function realProject(projectId) {
      return get(/databases/$(database)/documents/projects/$(projectId)).data;
    }
    function matchesRealProject(projectId, deptId, managerUid) {
      let p = realProject(projectId);
      return deptOf(p) == deptId && managerOf(p) == managerUid;
    }
    // وصول آمن للحقلين على مستندات قد تكون قديمة (سابقة لإضافة managerUid)
    // وتفتقد الحقل أصلاً؛ الوصول المباشر بالنقطة يفشل في هذه الحالة.
    function deptOf(data) { return data.get('departmentId', null); }
    function managerOf(data) { return data.get('managerUid', null); }

    // ------------------------- المستخدمون -------------------------
    match /users/{uid} {
      allow get: if isSignedIn() && (request.auth.uid == uid || isApproved());
      allow list: if isApproved();
      // التسجيل الذاتي: يُنشئ المستخدم سجله الخاص فقط بحالة "بانتظار الموافقة" ودور أساسي،
      // لا يمكنه منح نفسه دوراً أعلى أو حالة معتمدة مباشرة.
      allow create: if isSignedIn()
                    && request.auth.uid == uid
                    && request.resource.data.status == 'pending'
                    && request.resource.data.role == 'projectOfficer';
      // أي تغيير على الدور/الحالة/الإدارة لا يتم إلا عبر مسؤول النظام (عادة عبر Cloud Function).
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ------------------------- الإدارات -------------------------
    // قراءة عامة (حتى قبل تسجيل الدخول) لأن أسماء الإدارات تُعرض في نموذج إنشاء الحساب
    // لاختيار الإدارة المطلوبة؛ لا تحتوي على أي بيانات حساسة.
    match /departments/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ------------------------- المشاريع -------------------------
    match /projects/{id} {
      allow read: if isApproved() && (canViewAll() || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data)));
      // مسؤول النظام يملك صلاحية إضافة مشروع مباشرة (موافقته الذاتية كافية).
      // أي دور آخر لا يُنشئ مشروعاً مباشرة؛ الإنشاء عندها يتم فقط عبر Cloud
      // Function بعد اعتماد طلب "إضافة مشروع" من مسؤول النظام.
      allow create: if isAdmin();
      // يمكن لمدير الإدارة أو مدير المشروع المُسنَد إليه تحديث حقول التقدم والحالة
      // فقط، دون المساس بالموعد النهائي أو نقل المشروع لإدارة أخرى أو تغيير
      // مديره - أي تغيير في الموعد النهائي يمر عبر طلب موافقة منفصل، وتغيير
      // مدير المشروع لا يقوم به إلا مسؤول النظام.
      allow update: if isAdmin()
                    || (canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['dueDate', 'departmentId', 'createdByUid', 'managerUid']));
      allow delete: if isAdmin();
    }

    // ------------------------- مهام المشاريع -------------------------
    match /tasks/{id} {
      allow read: if isApproved() && (canViewAll() || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data)));
      allow create: if canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      allow update: if canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['projectId', 'departmentId', 'managerUid']);
      allow delete: if isAdmin();
    }

    // ------------------------- التحديثات اليومية (سجل غير قابل للتعديل) -------------------------
    match /dailyUpdates/{id} {
      allow read: if isApproved() && (canViewAll() || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data)));
      allow create: if canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      // السجل غير قابل للتعديل إطلاقاً. الحذف مسموح لمسؤول النظام فقط، وهو
      // لازم لحذف مشروع أو إدارة حذفاً متسلسلاً دون ترك تحديثات يتيمة.
      allow update: if false;
      allow delete: if isAdmin();
    }

    // ------------------------- المخاطر والعوائق -------------------------
    match /risks/{id} {
      allow read: if isApproved() && (canViewAll() || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data)));
      allow create: if canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      allow update: if canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['projectId', 'departmentId', 'managerUid']);
      allow delete: if isAdmin();
    }

    match /blockers/{id} {
      allow read: if isApproved() && (canViewAll() || canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data)));
      allow create: if canAccessProjectDoc(deptOf(request.resource.data), managerOf(request.resource.data))
                    && matchesRealProject(request.resource.data.projectId, deptOf(request.resource.data), managerOf(request.resource.data));
      allow update: if canAccessProjectDoc(deptOf(resource.data), managerOf(resource.data))
                    && !request.resource.data.diff(resource.data).affectedKeys()
                          .hasAny(['projectId', 'departmentId', 'managerUid']);
      allow delete: if isAdmin();
    }

    // ------------------- تثبيتات لوحة كل مستخدم -------------------
    // ما يختار مسؤول النظام إظهاره في لوحة قيادة مستخدم بعينه. المستخدم يقرأ
    // مستنده فقط ولا يكتبه — فلا يثبّت أحد لنفسه شيئاً.
    match /userFocus/{uid} {
      allow read: if isAdmin() || (isApproved() && request.auth.uid == uid);
      allow write: if isAdmin();
    }

    // ------------------- تخطيط لوحة كل مستخدم -------------------
    // تخصيص المستخدم لترتيب ودجات لوحته. بخلاف userFocus أعلاه، هذا المستند
    // يكتبه صاحبه بنفسه — فهو تفضيل عرض شخصي لا يرى أحد غيره، ولا يمنح أي
    // بيانات إضافية: كل ودجت يظل محكوماً بصلاحيات قراءة مصدره.
    match /userDashboards/{uid} {
      allow read, write: if isApproved() && request.auth.uid == uid;
    }

    // ------------------------- الأعمال التشغيلية -------------------------
    // بنود عمل مستقلة عن المشاريع، مُسنَدة لموظف داخل إدارة.
    match /works/{id} {
      // يقرأها من يرى كل الإدارات، أو مدير الإدارة صاحبة العمل، أو الموظف
      // المُسنَد إليه العمل نفسه.
      allow read: if isApproved()
                  && (canViewAll()
                      || isMyDeptAny(deptOf(resource.data))
                      || resource.data.get('assigneeUid', '') == request.auth.uid);
      // الإنشاء والإسناد لمن يملك صلاحية "إدارة الأعمال" ضمن نطاقه.
      allow create: if isAdmin()
                    || (perm('mw')
                        && (canViewAll() || isMyDeptAny(deptOf(request.resource.data))));
      // الموظف المُسنَد إليه يحدّث تقدّم عمله وحالته فقط، دون إعادة إسناده
      // لنفسه أو نقله لإدارة أخرى.
      allow update: if isAdmin()
                    || (perm('mw') && (canViewAll() || isMyDeptAny(deptOf(resource.data))))
                    || (resource.data.get('assigneeUid', '') == request.auth.uid
                        && !request.resource.data.diff(resource.data).affectedKeys()
                              .hasAny(['departmentId', 'assigneeUid', 'createdByUid']));
      allow delete: if isAdmin() || perm('del');
    }

    // ------------------------- طلبات الموافقة (مركز القرارات التنفيذية) -------------------------
    // تسجيل عضو / إضافة مشروع / تعديل موعد نهائي / قرار تنفيذي عام.
    match /approvalRequests/{id} {
      allow read: if isApproved()
                  && (isAdmin() || isExecutive()
                      || resource.data.requestedByUid == request.auth.uid
                      || isMyDeptAny(resource.data.departmentId));
      // يُسمح بالإنشاء حتى لمستخدم غير معتمد بعد (حالة التسجيل الذاتي).
      allow create: if isSignedIn();
      // لا يُعدَّل حقل الحالة (اعتماد/رفض) مباشرة من العميل بأي حال؛
      // الاعتماد الفعلي يتم حصرياً عبر Cloud Functions (approveRequest / rejectRequest)
      // التي تستخدم صلاحيات المسؤول الخلفية وتتحقق من الدور فعلياً على الخادم.
      allow update, delete: if false;
    }

    // ------------------------- سجل التدقيق -------------------------
    // القراءة حصراً لمسؤول النظام؛ لا يملك أي دور مخصص أو دور آخر الاطلاع عليه.
    match /auditLog/{id} {
      allow read: if isAdmin();
      allow create: if isApproved();
      allow update, delete: if false;
    }

    // ------------------------- التقارير -------------------------
    match /reports/{id} {
      allow read: if isApproved();
      allow create, update: if isAdmin() || isExecutive() || perm('mr');
      allow delete: if isAdmin();
    }

    // ------------------------- تخصيص لوحة القيادة -------------------------
    match /dashboardConfig/{id} {
      allow read: if isApproved();
      allow write: if isAdmin() || perm('md');
    }

    // ودجات مخصصة لكل مشروع على حدة (صفحة المشروع) — نفس صلاحية تخصيص
    // لوحة القيادة، بمعرّف المستند هو معرّف المشروع نفسه.
    match /projectWidgets/{id} {
      allow read: if isApproved();
      allow write: if isAdmin() || perm('md');
    }

    // إشعارات عامة تظهر لكل المستخدمين أعلى كل الصفحات — إنشاء وحذف حصراً
    // من مسؤول النظام.
    match /announcements/{id} {
      allow read: if isApproved();
      allow create, delete: if isAdmin();
      allow update: if false;
    }

    // ------------------------- الأدوار المخصصة -------------------------
    // تعريف الأدوار (الاسم ومجموعة الصلاحيات) يديره مسؤول النظام فقط؛ أما
    // تعيين دور لمستخدم معيّن فيتم حصراً عبر Cloud Function (setUserRole)
    // التي تضبط Custom Claims الفعلية.
    match /roles/{id} {
      allow read: if isApproved();
      allow write: if isAdmin();
    }

    // ------------------------- إعدادات المظهر (ألوان الهوية) -------------------------
    // قراءة عامة (حتى قبل تسجيل الدخول) لأن الألوان تُطبَّق على شاشتي الدخول
    // والتسجيل أيضاً؛ لا تحتوي على أي بيانات حساسة. التعديل حصراً لمسؤول النظام.
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
